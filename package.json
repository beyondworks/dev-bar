{
  "name": "devdock",
  "version": "0.1.0",
  "description": "macOS floating dock bar for managing parallel coding workspaces",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && env -u ELECTRON_RUN_AS_NODE node_modules/electron/dist/Electron.app/Contents/MacOS/Electron .",
    "dev:bg": "npm run build && env -u ELECTRON_RUN_AS_NODE node_modules/electron/dist/Electron.app/Contents/MacOS/Electron . &",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build:native": "cd native && swift build -c release",
    "package": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "framer-motion": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.0"
  }
}
